# Server Configuration
PORT=3001

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/coupang_uploader

# Lovable AI API Key (for translation service)
# Get this from your Lovable project settings
LOVABLE_API_KEY=your_lovable_api_key_here

# Optional: Default Coupang credentials (can also be passed per-request)
# COUPANG_ACCESS_KEY=your_access_key
# COUPANG_SECRET_KEY=your_secret_key
# COUPANG_VENDOR_ID=your_vendor_id
