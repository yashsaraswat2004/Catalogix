# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/nexcatalog

# CORS Origin (your frontend URL)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT Authentication (REQUIRED in production!)
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Gemini API Key (for translation service)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini image localization (Nano Banana Pro — best for Korean text)
# Default primary: gemini-3-pro-image (Nano Banana Pro)
# GEMINI_IMAGE_MODEL=gemini-3-pro-image
# Comma-separated fallback chain (first available model is used):
# GEMINI_IMAGE_MODELS=gemini-3-pro-image,gemini-3.1-flash-image,gemini-2.5-flash-image
# Output resolution for Pro model only (1K, 2K, or 4K):
# GEMINI_IMAGE_SIZE=2K

# SMTP Configuration (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@nexcatalog.com
FROM_NAME=NexCatalog

# Cookie Configuration (Production)
# For cross-origin deployments (Vercel frontend + Render backend), leave empty
# For same-domain deployments, use your root domain: .example.com
COOKIE_DOMAIN=

