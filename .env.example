# NexCatalog Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (for production, change to your deployed backend URL)
VITE_API_URL=http://localhost:3001

# App Configuration
VITE_APP_NAME=NexCatalog
VITE_APP_URL=https://nexcatalog.com

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false

# Sentry DSN (optional - for error tracking)
# VITE_SENTRY_DSN=your-sentry-dsn-here

# Gemini API (optional - for Shipping tools: CN22 AI parsing, India Post translation)
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
